{
  "extends": [
    "config:recommended"
  ],
  "labels": [
    ">renovate"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.buildkite/.*\\.ya?ml$/",
        "/^\\.buildkite/Makefile$/"
      ],
      "matchStrings": [
        "(?:image:\\s+|CI_IMAGE\\s*\\?=\\s*)(?<depName>docker\\.elastic\\.co/ci-agent-images/cloud-k8s-operator/buildkite-agent):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^test/e2e/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\nENV \\w+=(?<currentValue>[^\\n]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.custom-gcl\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\nversion: (?<currentValue>[^\\n]+)"
      ]
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "schedule": [
    "after 1am on monday"
  ],
  "postUpgradeTasks": {
    "commands": [
      "make generate"
    ],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "github.com/elastic/cloud-on-k8s/v3"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "The definition in the design document for a Docker image a) isn't a valid Docker image, and b) shouldn't be kept up-to-date even if so, as design docs should be a point-in-time reference",
      "matchPackageNames": [
        "docker.elastic.co/k8s-operators"
      ],
      "matchFileNames": [
        "docs/design/0005-configurable-operator.md"
      ],
      "enabled": false
    },
    {
      "description": "Docker images in the release notes should not be updated",
      "matchFileNames": [
        "docs/release-notes/index.md"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "enabled": true,
      "postUpdateOptions": [
        "gomodTidy",
        "gomodTidyAll"
      ],
      "matchPackageNames": [
        "github.com/elastic/{/,}**",
        "docker.elastic.co/wolfi/{/,}**"
      ]
    },
    {
      "description": "ubi-micro and ubi-minimal are pinned to a <major>.<minor>-<build timestamp> tag (e.g. 9.8-1793580630); only consider tags of that form so Renovate doesn't compare them against bare timestamp or 9.x tags",
      "matchPackageNames": [
        "registry.access.redhat.com/ubi9/ubi-micro",
        "registry.access.redhat.com/ubi9/ubi-minimal"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d{10})$"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true,
      "postUpdateOptions": [
        "gomodTidy",
        "gomodTidyAll"
      ],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin"
      ],
      "enabled": true,
      "postUpdateOptions": [
        "gomodTidy",
        "gomodTidyAll"
      ],
      "matchPackageNames": [
        "!github.com/elastic/{/,}**"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false,
      "matchPackageNames": [
        "!github.com/elastic/{/,}**",
        "!docker.elastic.co/wolfi/{/,}**",
        "!docker.io/library/golang",
        "!k8s.io/utils"
      ]
    },
    {
      "matchPackageNames": [
        "k8s.io/utils"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "postUpdateOptions": [
        "gomodTidy",
        "gomodTidyAll"
      ]
    },
    {
      "groupName": "all ungrouped dependencies",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "groupName": "elastic-deps",
      "matchPackageNames": [
        "/^github.com/elastic/",
        "/^go.elastic.co/"
      ]
    },
    {
      "groupName": "k8s",
      "matchPackageNames": [
        "/k8s.io/"
      ]
    },
    {
      "matchPackageNames": [
        "go",
        "golang",
        "docker.io/library/golang",
        "docker.elastic.co/wolfi/go",
        "github.com/golangci/golangci-lint"
      ],
      "groupName": "go"
    },
    {
      "matchPackageNames": [
        "docker.elastic.co/ci-agent-images/cloud-k8s-operator/buildkite-agent"
      ],
      "groupName": "buildkite-agent",
      "enabled": true,
      "matchUpdateTypes": [
        "digest"
      ],
      "schedule": [
        "at any time"
      ]
    }
  ],
  "separateMajorMinor": true
}
